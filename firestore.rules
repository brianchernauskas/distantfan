rules_version = '2';
// Distant Fan: paste into Firebase console → Firestore → Rules, then Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function data() { return request.resource.data; }
    // Must match ADMINS in assets/js/config.js.
    function isAdmin() { return signedIn() && request.auth.uid in ['euJIvUd4sig4pGT4fE7SPSpE6lA3']; }

    // Public fan profile. Home is a geohash of at most 5 characters (~4.9 × 4.9 km, ~3 mi);
    // anything more precise is rejected, so a street-level location can never be stored.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && data().keys().hasOnly(['name', 'teams', 'cell', 'area', 'updatedAt'])
        && str(data().name, 1, 40)
        && data().teams is list && data().teams.size() >= 1 && data().teams.size() <= 8
        && str(data().cell, 1, 5) && data().cell.matches('^[0-9b-hjkmnp-z]+$')
        && str(data().area, 0, 60)
        && data().updatedAt == request.time;
      allow delete: if signedIn() && me() == uid;
    }

    // Game-day email opt-in (tools/digest reads it with the admin key). The doc id is a random 128-bit
    // token that goes into each email's unsubscribe link, so it works as a capability URL: nobody can
    // list the collection, and whoever holds the token can only switch optIn OFF, without signing in.
    function emailShape() {
      return data().keys().hasOnly(['uid', 'email', 'optIn', 'updatedAt'])
        && data().uid == me() && str(data().email, 3, 120) && data().optIn is bool
        && data().updatedAt == request.time;
    }
    match /emailPrefs/{id} {
      allow read: if signedIn() && (resource.data.uid == me() || isAdmin());
      allow create: if signedIn() && id.matches('^[0-9a-f]{32}$') && emailShape();
      allow update: if (signedIn() && resource.data.uid == me() && emailShape())
        || (data().diff(resource.data).affectedKeys().hasOnly(['optIn']) && data().optIn == false);
      allow delete: if signedIn() && resource.data.uid == me();
    }
    // Send log so a fan is never emailed twice in a few days. Admin only.
    match /mailLog/{id} { allow read, write: if isAdmin(); }

    // Watch spots are public places, so exact coordinates are fine here.
    match /spots/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && data().keys().hasOnly(['name', 'address', 'club', 'note', 'lat', 'lng', 'teams', 'by', 'byName', 'createdAt'])
        && data().by == me()
        && str(data().name, 1, 80) && str(data().address, 0, 120) && str(data().note, 0, 200) && str(data().byName, 0, 40)
        && str(data().get('club', ''), 0, 80)
        && data().lat is number && data().lat >= -90 && data().lat <= 90
        && data().lng is number && data().lng >= -180 && data().lng <= 180
        && data().teams is list && data().teams.size() >= 1 && data().teams.size() <= 6
        && data().createdAt == request.time;
      allow delete: if signedIn() && resource.data.by == me();
      // The admin approves scout finds (extra source fields) and can remove any spot.
      allow create, update, delete: if isAdmin();
    }

    // Watch-party scout (tools/scout). Its admin key bypasses these rules; the admin reviews in the app.
    match /scoutQueue/{id} { allow read, write: if isAdmin(); }
    match /scoutRejects/{id} { allow read, write: if isAdmin(); }

    // "Still accurate?" reports from fans. One per fan per spot; only the admin reads them.
    match /spotReports/{id} {
      allow create, update: if signedIn()
        && data().uid == me() && id == data().spotId + '_' + me()
        && data().keys().hasOnly(['spotId', 'spotName', 'uid', 'name', 'reason', 'note', 'createdAt'])
        && str(data().spotId, 1, 80) && str(data().spotName, 0, 80) && str(data().name, 1, 40)
        && str(data().reason, 1, 40) && str(data().note, 0, 300)
        && data().createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Bar/venue owners asking to be added, from the public landing page (no account, so no
    // signedIn() check). May contain a contact email/phone, so only the admin reads them.
    match /venueLeads/{id} {
      allow create: if data().keys().hasOnly(['venue', 'address', 'contact', 'note', 'createdAt'])
        && str(data().venue, 1, 80) && str(data().address, 0, 120) && str(data().contact, 1, 120)
        && str(data().note, 0, 400) && data().createdAt is string && data().createdAt.size() < 40;
      allow read, delete: if isAdmin();
    }

    // One active check-in per fan per team; the doc id is `${uid}_${teamId}`.
    match /checkins/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && data().uid == me() && id == me() + '_' + data().teamId
        && data().keys().hasOnly(['uid', 'name', 'teamId', 'spotId', 'gameId', 'gameName', 'gameDate', 'expiresAt', 'createdAt'])
        && str(data().name, 1, 40) && str(data().spotId, 1, 64)
        && data().expiresAt is number && data().expiresAt < request.time.toMillis() + 30 * 86400000;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /rooms/{room}/messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && data().keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
        && data().uid == me() && str(data().name, 1, 40) && str(data().text, 1, 500)
        && data().createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == me();
    }
  }
}
